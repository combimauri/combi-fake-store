{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/fake-store/browser",
  "routes": [
    { "src": "/", "dest": "/api" },
    {
      "src": "/(.*)-([A-Za-z0-9_-]{8})\\.(js|css)$",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api" }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/fake-store/**"
    }
  }
}
